<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Mis-Scan Control Center</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand-wrap">
      <div class="brand-mark">MS</div>
      <div>
        <div class="brand">MIS-SCAN CONTROL CENTER</div>
        <div class="subtitle">Produtividade • Tratativas • Calendarização V3</div>
      </div>
    </div>
    <div class="header-actions">
      <label class="upload-btn" for="csvUpload">Carregar Misscan</label>
      <input id="csvUpload" type="file" accept=".csv,text/csv" hidden />
      <label class="upload-btn secondary-upload" for="hcUpload">Carregar Base HC</label>
      <input id="hcUpload" type="file" accept=".csv,text/csv" hidden />
      <button id="exportBtn" class="ghost-btn">Exportar filtrado</button>
    </div>
  </header>

  <nav class="tabs" aria-label="Navegação principal">
    <button class="tab active" data-tab="produtividade">Produtividade</button>
    <button class="tab" data-tab="tratativas">Tratativas</button>
    <button class="tab" data-tab="calendarizacao">Calendarização</button>
  </nav>

  <main>
    <section id="produtividade" class="view active">
      <div class="filter-panel">
        <div class="filter-grid filter-grid-wide">
          <label>Responsabilidade<select id="areaFilter"><option value="">Todas</option></select></label>
          <label>Processo<select id="processFilter"><option value="">Todos</option></select></label>
          <label>Identificação<select id="identFilter"><option value="">Todas</option></select></label>
          <label>Turno<select id="turnoFilter"><option value="">Todos</option></select></label>
          <label>Setor<select id="setorFilter"><option value="">Todos</option></select></label>
          <label>Líder<select id="liderFilter"><option value="">Todos</option></select></label>
          <label>Tipo HC<select id="tipoFilter"><option value="">Todos</option></select></label>
          <label>Destino<select id="stationFilter"><option value="">Todos</option></select></label>
          <label class="search-label">Colaborador / OPSID<input id="operatorSearch" type="search" placeholder="Buscar colaborador..." /></label>
          <button id="resetBtn" class="reset-btn">Limpar filtros</button>
        </div>
        <div id="dataNote" class="data-note"></div>
      </div>

      <div class="kpi-grid kpi-grid-7">
        <article class="kpi"><span>BR Misscan</span><strong id="kBR">—</strong><small id="kDate">—</small></article>
        <article class="kpi"><span>TO envolvidas</span><strong id="kTO">—</strong><small>TO únicas</small></article>
        <article class="kpi kpi-yellow"><span>Esteira</span><strong id="kEsteira">—</strong><small id="pEsteira">—</small></article>
        <article class="kpi kpi-purple"><span>Expedição</span><strong id="kExpedicao">—</strong><small id="pExpedicao">—</small></article>
        <article class="kpi kpi-gray"><span>Operador não identificado</span><strong id="kUnidentified">—</strong><small id="pUnidentified">—</small></article>
        <article class="kpi"><span>Colaboradores</span><strong id="kOperators">—</strong><small>identificados</small></article>
        <article class="kpi kpi-alert"><span>Pendências HC</span><strong id="kHCPending">—</strong><small>cadastro/ambiguidade</small></article>
      </div>

      <div class="dashboard-grid">
        <article class="panel">
          <div class="panel-head"><div><h2>Responsabilidade operacional</h2><p>Process Fail como regra principal; TO Mis Status como fallback</p></div></div>
          <div id="areaBars" class="bar-list"></div>
        </article>
        <article class="panel">
          <div class="panel-head"><div><h2>Process Fail</h2><p>BR únicos por tipo de falha</p></div></div>
          <div id="processBars" class="bar-list"></div>
        </article>
      </div>

      <div class="dashboard-grid dashboard-grid-3">
        <article class="panel">
          <div class="panel-head"><div><h2>Por turno</h2><p>BR atribuídos a colaboradores identificados</p></div></div>
          <div id="turnoBars" class="bar-list compact"></div>
        </article>
        <article class="panel">
          <div class="panel-head"><div><h2>Por setor</h2><p>Enriquecimento da Base de HC</p></div></div>
          <div id="setorBars" class="bar-list compact"></div>
        </article>
        <article class="panel">
          <div class="panel-head"><div><h2>Por liderança</h2><p>Visibilidade para tratativas</p></div></div>
