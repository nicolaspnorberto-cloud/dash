          <table>
            <thead><tr><th>#</th><th>Líder</th><th>BR</th><th>TO</th><th>Colaboradores</th><th>Esteira</th><th>Expedição</th><th>Turnos</th></tr></thead>
            <tbody id="leaderBody"></tbody>
          </table>
        </div>
      </article>

      <article class="panel table-panel">
        <div class="panel-head"><div><h2>Pendências de Base HC</h2><p>Colaboradores identificados no Misscan que não possuem vínculo único/confiável na Base HC.</p></div><button id="exportPendingBtn" class="ghost-dark">Exportar pendências</button></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>#</th><th>Colaborador / valor</th><th>OPSID</th><th>BR</th><th>Status HC</th><th>Turno</th><th>Setor</th><th>Líder</th></tr></thead>
            <tbody id="pendingBody"></tbody>
          </table>
        </div>
      </article>
    </section>

    <section id="calendarizacao" class="view">
      <div class="projection-hero">
        <div>
          <span class="eyebrow">CALENDARIZAÇÃO INTELIGENTE</span>
          <h1>Projeção operacional do Misscan</h1>
          <p>
            Projeção ponderada por volume, com taxa histórica por turno, capacidade planejada,
            carga operacional e cenários Otimista / Base / Conservador.
          </p>
        </div>
      </div>

      <div class="projection-controls panel">
        <div class="panel-head">
          <div>
            <h2>Parâmetros do realizado</h2>
            <p>Use o volume correspondente à mesma janela da base de Misscan analisada.</p>
          </div>
        </div>

        <div class="calendar-params">
          <label>Volume realizado
            <input id="actualVolume" type="number" min="0" step="1" placeholder="Ex.: 2496400" />
          </label>

          <label>Meta Misscan (%)
            <input id="targetRate" type="number" min="0" step="0.001" value="0.94" />
          </label>

          <div class="scenario-box">
            <span>Cenário</span>
            <div class="scenario-buttons">
              <button type="button" class="scenario-btn" data-scenario="optimistic">Otimista</button>
              <button type="button" class="scenario-btn active" data-scenario="base">Base</button>
              <button type="button" class="scenario-btn" data-scenario="conservative">Conservador</button>
            </div>
            <small id="scenarioLabel">Base • fator 1,00x</small>
          </div>
        </div>
      </div>

      <div class="kpi-grid calendar-kpis">
        <article class="kpi">
          <span>Misscan realizado</span>
          <strong id="projMisscan">—</strong>
          <small>BR únicos da base filtrada</small>
        </article>

        <article class="kpi">
          <span>Indicador atual</span>
          <strong id="currentRate">—</strong>
          <small>Misscan / volume realizado</small>
        </article>

        <article class="kpi kpi-purple">
          <span>Meta</span>
          <strong id="targetCard">—</strong>
          <small>referência operacional</small>
        </article>

        <article class="kpi kpi-yellow">
          <span>Projeção fechamento</span>
          <strong id="forecastRate">—</strong>
          <small id="forecastGap">—</small>
        </article>

        <article class="kpi">
          <span>Volume futuro</span>
          <strong id="futureVolumeCard">—</strong>
          <small>calendarizado</small>
        </article>

        <article class="kpi kpi-alert">
          <span>Dias de risco</span>
          <strong id="riskDaysCard">—</strong>
          <small>projeção acima da faixa</small>
        </article>
      </div>

      <div class="dashboard-grid calendar-reference-grid">
        <article class="panel">
          <div class="panel-head">
            <div>
              <h2>Referência histórica de produtividade</h2>
